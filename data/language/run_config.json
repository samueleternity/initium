{
  "schema_version": 1,
  "tokenizer_path": "data/language/build/tokenizer/tokenizer.json",
  "vocab_size": 32000,
  "max_sequence_tokens": 2048,
  "shard_tokens": 1000000,
  "seed": 0,
  "hidden_size": 512,
  "batch_size": 16,
  "learning_rate": 0.0003,
  "minimum_learning_rate": 0.00003,
  "weight_decay": 0.1,
  "warmup_steps": 1000,
  "evaluate_every": 1000,
  "evaluation_batches": 8,
  "max_grad_norm": 1.0,
  "log_every": 20,
  "objective_sampling_weights": {
    "text": 0.7,
    "same_state": 0.1,
    "transition": 0.1,
    "logic": 0.05,
    "dialogue": 0.05
  },
  "loss_weights": {
    "text": 1.0,
    "same_state": 0.1,
    "transition": 0.1,
    "logic": 0.1,
    "dialogue": 0.25
  },
  "architecture": {
    "split_graph": true,
    "split_graph_variant": "mamba1",
    "split_graph_num_blocks": 4,
    "mamba_d_state": 16,
    "mamba_d_conv": 4,
    "mamba_expand": 2,
    "memory_type": "none",
    "workspace_token_id_input": true,
    "workspace_parallel_dense": true,
    "workspace_block_index": 1,
    "workspace_num_slots": 128,
    "workspace_key_dim": 64,
    "workspace_scan_chunk": 32,
    "modulation": true,
    "modulation_targets": ["dt"],
    "modulation_blocks": [3],
    "modulation_source": "workspace",
    "modulation_rank": 32,
    "modulation_alphas": {"dt": 0.5, "a": 0.5, "B": 0.3, "C": 0.3, "D": 0.3},
    "modulation_lambda": 0.0,
    "modulation_temporal_lambda": 0.0,
    "modulation_lr_scale": 1.0,
    "modulation_alpha_warmup_steps": 3000,
    "neuromod_combine": ["plasticity", "gate", "consolidation", "responsiveness"],
    "neuromod": "off",
    "neuromod_groups": ["backbone", "moe", "workspace", "modulation", "task_head"],
    "neuromod_retention_control": true,
    "neuromod_loss_outlier_gating": true,
    "neuromod_consolidation_lambda": 0.1,
    "neuromod_range": 2.0,
    "neuromod_every": 50,
    "neuromod_slew": 0.05,
    "neuromod_seed": 0,
    "neuromod_gate_kappa": 2.0,
    "fp32": true,
    "total_steps": 130000,
    "checkpoint_every": 5000,
    "seed": 0
  }
}
